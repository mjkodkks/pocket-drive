{
  "name": "line-gdrive-bot-drizzle",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:push": "drizzle-kit push",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "bunx rimraf node_modules bun.lock dist drizzle"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "googleapis": "^171.4.0",
    "logixlysia": "^6.3.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/pino": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3"
  }
}